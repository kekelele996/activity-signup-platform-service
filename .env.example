# EventGo 本地 Compose 启动配置（仅用于开发/评测）
COMPOSE_PROJECT_NAME=gbevent
DB_NAME=gbevent_db
DB_USER=gbevent_user
DB_PASSWORD=gbevent_pwd
DB_ROOT_PASSWORD=gbevent_root
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE_HOURS=72
APP_CORS_ORIGINS=http://localhost:18506
FRONTEND_PORT=18506
BACKEND_PORT=19506
DB_PORT=57506
